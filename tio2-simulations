<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TiO₂ Optical Light Scattering & Ray Optics Simulation</title>
  <style>
    :root {
      --bg-color: #030712;
      --panel-bg: rgba(17, 24, 39, 0.85);
      --border-color: #1f2937;
      --text-main: #f9fafb;
      --text-muted: #9ca3af;
      --accent-color: #6366f1;
      --tio2-color: #38bdf8;
      --caco3-color: #fb923c;
      --kaolin-color: #4ade80;
      --baso4-color: #c084fc;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      padding: 20px;
      display: flex;
      justify-content: center;
      min-height: 100vh;
    }

    .dashboard {
      width: 100%;
      max-width: 1350px;
      display: grid;
      grid-template-columns: 380px 1fr;
      gap: 20px;
    }

    @media (max-width: 1024px) {
      .dashboard { grid-template-columns: 1fr; }
    }

    .panel {
      background: var(--panel-bg);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .panel-title {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: var(--text-main);
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .control-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .slider-card {
      background: rgba(31, 41, 55, 0.5);
      padding: 12px 14px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.05);
      transition: all 0.2s ease;
    }
    .slider-card:hover { border-color: rgba(255,255,255,0.15); }

    .slider-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      font-size: 0.85rem;
    }

    .slider-header span.label { font-weight: 600; }
    .slider-header span.value { font-family: 'Courier New', monospace; font-size: 0.95rem; font-weight: bold; }

    input[type=range] {
      width: 100%;
      height: 6px;
      border-radius: 3px;
      background: #374151;
      outline: none;
      cursor: pointer;
    }

    .caco3-card { border-left: 4px solid var(--caco3-color); }
    .caco3-card input[type=range] { accent-color: var(--caco3-color); }
    
    .kaolin-card { border-left: 4px solid var(--kaolin-color); }
    .kaolin-card input[type=range] { accent-color: var(--kaolin-color); }

    .baso4-card { border-left: 4px solid var(--baso4-color); }
    .baso4-card input[type=range] { accent-color: var(--baso4-color); }

    .optics-card { border-left: 4px solid var(--tio2-color); }
    .optics-card input[type=range] { accent-color: var(--tio2-color); }

    .preset-buttons {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }

    .btn {
      background: #1f2937;
      color: var(--text-main);
      border: 1px solid var(--border-color);
      padding: 8px 6px;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: center;
    }

    .btn:hover { background: #374151; border-color: #4b5563; }
    .btn-active { background: var(--accent-color); border-color: var(--accent-color); }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .metric-card {
      background: rgba(17, 24, 39, 0.8);
      padding: 12px;
      border-radius: 8px;
      text-align: center;
      border: 1px solid rgba(255,255,255,0.05);
    }

    .metric-card .title { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 4px; }
    .metric-card .val { font-size: 1.2rem; font-weight: 800; font-family: 'Courier New', monospace; }

    .canvas-container {
      position: relative;
      width: 100%;
      height: 520px;
      background: #000;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border-color);
      box-shadow: inset 0 0 50px rgba(0,0,0,0.8);
    }

    canvas { width: 100%; height: 100%; display: block; }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      background: rgba(17, 24, 39, 0.8);
      padding: 10px 14px;
      border-radius: 6px;
      font-size: 0.78rem;
      border: 1px solid var(--border-color);
    }

    .legend-item { display: flex; align-items: center; gap: 6px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .rect { width: 14px; height: 6px; border-radius: 2px; display: inline-block; }

    .toggle-group {
      display: flex;
      gap: 10px;
      font-size: 0.8rem;
      align-items: center;
    }

    .toggle-group label {
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      color: var(--text-muted);
    }

    .toggle-group input[type=checkbox] {
      accent-color: var(--accent-color);
      cursor: pointer;
    }
  </style>
</head>
<body>

<div class="dashboard">
  <!-- Controls Panel -->
  <div class="panel">
    <div class="panel-title">System Composition</div>

    <div class="control-group">
      <!-- CaCO3 Slider -->
      <div class="slider-card caco3-card">
        <div class="slider-header">
          <span class="label" style="color: var(--caco3-color);">Ultrafine CaCO₃</span>
          <span class="value" id="caco3-val">2.0%</span>
        </div>
        <input type="range" id="caco3" min="0" max="4" step="0.5" value="2">
      </div>

      <!-- Kaolin Slider -->
      <div class="slider-card kaolin-card">
        <div class="slider-header">
          <span class="label" style="color: var(--kaolin-color);">Hydrous Kaolin</span>
          <span class="value" id="kaolin-val">1.0%</span>
        </div>
        <input type="range" id="kaolin" min="0" max="3" step="0.5" value="1">
      </div>

      <!-- BaSO4 Slider -->
      <div class="slider-card baso4-card">
        <div class="slider-header">
          <span class="label" style="color: var(--baso4-color);">Barium Sulfate (BaSO₄)</span>
          <span class="value" id="baso4-val">0.0%</span>
        </div>
        <input type="range" id="baso4" min="0" max="4" step="0.5" value="0">
      </div>

      <!-- Ray Density Slider -->
      <div class="slider-card optics-card">
        <div class="slider-header">
          <span class="label" style="color: var(--tio2-color);">Incident Photon Rays</span>
          <span class="value" id="rays-val">80</span>
        </div>
        <input type="range" id="rays" min="20" max="150" step="10" value="80">
      </div>
    </div>

    <!-- Quick Formulation Presets -->
    <div class="control-group">
      <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Presets:</span>
      <div class="preset-buttons">
        <button class="btn" onclick="setPreset(0,0,0)">70/0/0 Pure</button>
        <button class="btn" onclick="setPreset(2,0,0)">68/2/0 CaCO₃</button>
        <button class="btn" onclick="setPreset(0,2,0)">68/0/2 Kaolin</button>
        <button class="btn" onclick="setPreset(1,1,0)">68/1/1 Blend</button>
        <button class="btn" onclick="setPreset(2,1,0)">67/2/1 Synergy</button>
        <button class="btn" onclick="setPreset(3,2,0)">65/3/2 High</button>
      </div>
    </div>

    <!-- Quantitative Metrics -->
    <div class="panel-title">Optical Physics Analysis</div>
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="title">TiO₂ Mass Loading</div>
        <div class="val" id="tio2-val" style="color: var(--tio2-color);">67.0%</div>
      </div>
      <div class="metric-card">
        <div class="title">Interparticle Distance</div>
        <div class="val" id="spacing-val">1.82 µm</div>
      </div>
      <div class="metric-card">
        <div class="title">Scattering Index (S)</div>
        <div class="val" id="efficiency-val" style="color: #4ade80;">94%</div>
      </div>
      <div class="metric-card">
        <div class="title">Optical Crowding</div>
        <div class="val" id="crowding-val" style="color: #38bdf8;">Low</div>
      </div>
    </div>

    <div class="toggle-group">
      <label><input type="checkbox" id="show-fields" checked> Rayleigh/Mie Fields</label>
      <label><input type="checkbox" id="show-rays" checked> Light Rays</label>
    </div>
  </div>

  <!-- Optical Ray Tracing Viewport -->
  <div class="panel">
    <div class="panel-title">
      <span>Ray-Tracing & Photonic Scattering Simulation</span>
      <span style="font-size: 0.75rem; color: #4ade80; font-weight: normal;">● LIVE PHYSICS ENGINE</span>
    </div>

    <div class="legend">
      <div class="legend-item"><span class="dot" style="background: var(--tio2-color); box-shadow: 0 0 8px var(--tio2-color);"></span> TiO₂ (Rutile n=2.7)</div>
      <div class="legend-item"><span class="dot" style="background: var(--caco3-color);"></span> CaCO₃ (Equant n=1.6)</div>
      <div class="legend-item"><span class="rect" style="background: var(--kaolin-color);"></span> Kaolin Platelet (n=1.56)</div>
      <div class="legend-item"><span class="dot" style="background: var(--baso4-color); width: 12px; height: 12px;"></span> BaSO₄ (Dense n=1.64)</div>
      <div class="legend-item"><span class="dot" style="background: #ffffff; box-shadow: 0 0 6px #fff;"></span> Photon Ray Scattering</div>
    </div>

    <div class="canvas-container">
      <canvas id="simCanvas"></canvas>
    </div>
  </div>
</div>

<script>
  const canvas = document.getElementById('simCanvas');
  const ctx = canvas.getContext('2d');

  const caco3Input = document.getElementById('caco3');
  const kaolinInput = document.getElementById('kaolin');
  const baso4Input = document.getElementById('baso4');
  const raysInput = document.getElementById('rays');
  const showFieldsCheckbox = document.getElementById('show-fields');
  const showRaysCheckbox = document.getElementById('show-rays');

  let width, height;
  let particles = [];
  let lightRays = [];
  let animId;

  function resizeCanvas() {
    width = canvas.parentElement.clientWidth;
    height = canvas.parentElement.clientHeight;
    canvas.width = width;
    canvas.height = height;
    initSimulation();
  }

  function setPreset(c, k, b) {
    caco3Input.value = c;
    kaolinInput.value = k;
    baso4Input.value = b;
    initSimulation();
  }

  // Refractive Indices
  const N_TIO2 = 2.7;
  const N_CACO3 = 1.6;
  const N_KAOLIN = 1.56;
  const N_BASO4 = 1.64;
  const N_MATRIX = 1.50; // NBR Matrix

  class Particle {
    constructor(x, y, type, radius, angle = 0, width = 0, height = 0) {
      this.x = x;
      this.y = y;
      this.type = type; // 'tio2', 'caco3', 'kaolin', 'baso4'
      this.radius = radius;
      this.angle = angle;
      this.w = width;
      this.h = height;
      
      // Calculate scattering potential based on refractive index contrast (n - n_matrix)^2
      if (type === 'tio2') this.scatteringPower = Math.pow(N_TIO2 - N_MATRIX, 2);
      else if (type === 'caco3') this.scatteringPower = Math.pow(N_CACO3 - N_MATRIX, 2);
      else if (type === 'kaolin') this.scatteringPower = Math.pow(N_KAOLIN - N_MATRIX, 2);
      else if (type === 'baso4') this.scatteringPower = Math.pow(N_BASO4 - N_MATRIX, 2);
    }

    draw(ctx, showFields) {
      ctx.save();
      ctx.translate(this.x, this.y);
      ctx.rotate(this.angle);

      if (this.type === 'tio2') {
        // High refractive index scattering field glow (Mie scattering representation)
        if (showFields) {
          const glow = ctx.createRadialGradient(0, 0, this.radius * 0.8, 0, 0, this.radius * 2.8);
          glow.addColorStop(0, 'rgba(56, 189, 248, 0.4)');
          glow.addColorStop(0.5, 'rgba(56, 189, 248, 0.15)');
          glow.addColorStop(1, 'rgba(56, 189, 248, 0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(0, 0, this.radius * 2.8, 0, Math.PI * 2);
          ctx.fill();
        }

        // Particle Core
        ctx.fillStyle = '#38bdf8';
        ctx.shadowColor = '#0284c7';
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = '#e0f2fe';
        ctx.stroke();

      } else if (this.type === 'caco3') {
        // Fine Equant CaCO3
        ctx.fillStyle = '#fb923c';
        ctx.beginPath();
        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#fdba74';
        ctx.lineWidth = 1;
        ctx.stroke();

      } else if (this.type === 'kaolin') {
        // Platelet Kaolin Structure
        ctx.fillStyle = '#4ade80';
        ctx.shadowColor = '#22c55e';
        ctx.shadowBlur = 6;
        ctx.beginPath();
        ctx.roundRect(-this.w/2, -this.h/2, this.w, this.h, 3);
        ctx.fill();
        ctx.strokeStyle = '#86efac';
        ctx.stroke();

      } else if (this.type === 'baso4') {
        // Dense Large BaSO4
        ctx.fillStyle = '#c084fc';
        ctx.beginPath();
        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#e9d5ff';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      ctx.restore();
    }
  }

  class PhotonRay {
    constructor(x, y, angle) {
      this.reset(x, y, angle);
    }

    reset(x, y, angle) {
      this.x = x;
      this.y = y;
      this.vx = Math.cos(angle) * 3.5;
      this.vy = Math.sin(angle) * 3.5;
      this.history = [];
      this.maxHistory = 15;
      this.intensity = 1.0;
    }

    update(particles) {
      this.history.push({x: this.x, y: this.y});
      if (this.history.length > this.maxHistory) this.history.shift();

      this.x += this.vx;
      this.y += this.vy;

      // Check collision/scattering with particles
      for (let p of particles) {
        let dx = this.x - p.x;
        let dy = this.y - p.y;
        let dist = Math.sqrt(dx * dx + dy * dy);

        let scatterRadius = p.type === 'kaolin' ? p.w / 2 : p.radius;

        if (dist < scatterRadius + 2) {
          // Calculate scattering angle based on particle type (TiO2 scatters strongly)
          let scatterAngle = Math.atan2(dy, dx) + (Math.random() - 0.5) * (p.type === 'tio2' ? 1.8 : 0.8);
          let speed = 3.5;
          this.vx = Math.cos(scatterAngle) * speed;
          this.vy = Math.sin(scatterAngle) * speed;
          this.intensity *= 0.92; // Energy attenuation
          break;
        }
      }

      // Reset ray if out of bounds or energy depleted
      if (this.x < 0 || this.x > width || this.y < 0 || this.y > height || this.intensity < 0.1) {
        this.reset(Math.random() * width, 0, Math.PI / 2 + (Math.random() - 0.5) * 0.4);
      }
    }

    draw(ctx) {
      if (this.history.length < 2) return;

      ctx.beginPath();
      ctx.moveTo(this.history[0].x, this.history[0].y);
      for (let i = 1; i < this.history.length; i++) {
        ctx.lineTo(this.history[i].x, this.history[i].y);
      }
      ctx.strokeStyle = `rgba(255, 255, 255, ${this.intensity * 0.75})`;
      ctx.lineWidth = 1.5;
      ctx.shadowColor = '#ffffff';
      ctx.shadowBlur = 8;
      ctx.stroke();
    }
  }

  function initSimulation() {
    const c = parseFloat(caco3Input.value);
    const k = parseFloat(kaolinInput.value);
    const b = parseFloat(baso4Input.value);
    const numRays = parseInt(raysInput.value);

    const totalExtenders = c + k + b;
    const tio2 = Math.max(50, 70 - totalExtenders);

    // Update Text Metrics
    document.getElementById('caco3-val').innerText = c.toFixed(1) + '%';
    document.getElementById('kaolin-val').innerText = k.toFixed(1) + '%';
    document.getElementById('baso4-val').innerText = b.toFixed(1) + '%';
    document.getElementById('rays-val').innerText = numRays;
    document.getElementById('tio2-val').innerText = tio2.toFixed(1) + '%';

    const spacingCalc = (0.35 + (c * 0.45) + (k * 0.85) + (b * 0.15)).toFixed(2);
    document.getElementById('spacing-val').innerText = `${spacingCalc} µm`;

    let crowdingPenalty = Math.max(0, (tio2 - 65) * 2.8);
    let synergyBonus = (c > 0 && k > 0) ? 14 : 0;
    let baso4Penalty = b * 3.5;
    let efficiency = Math.round(100 - crowdingPenalty + synergyBonus - baso4Penalty);
    efficiency = Math.max(40, Math.min(99, efficiency));

    const effElem = document.getElementById('efficiency-val');
    effElem.innerText = `${efficiency}%`;

    const crowdElem = document.getElementById('crowding-val');
    if (tio2 > 68) {
      crowdElem.innerText = "High (Crowded)";
      crowdElem.style.color = "#f87171";
    } else if (c > 0 && k > 0) {
      crowdElem.innerText = "Minimal (Synergy)";
      crowdElem.style.color = "#4ade80";
    } else {
      crowdElem.innerText = "Moderate";
      crowdElem.style.color = "#fb923c";
    }

    // Generate Microstructure Particles
    particles = [];
    const spacingFactor = 1 + (totalExtenders * 0.15);

    // 1. Add Kaolin Platelets (Barrier and Spacing)
    if (k > 0) {
      const kaolinCount = Math.round(k * 3.5);
      for (let i = 0; i < kaolinCount; i++) {
        let x = 80 + (i % 4) * (width / 4.5) + (i * 17 % 30);
        let y = 100 + Math.floor(i / 4) * 120 + (i * 23 % 40);
        let angle = ((i % 2 === 0 ? 1 : -1) * (i * 5 % 12)) * Math.PI / 180;
        particles.push(new Particle(x, y, 'kaolin', 0, angle, 85, 12));
      }
    }

    // 2. Add BaSO4 Large Particles
    if (b > 0) {
      const baso4Count = Math.round(b * 2.5);
      for (let i = 0; i < baso4Count; i++) {
        let x = 110 + (i % 3) * (width / 3.5) + (i * 19 % 40);
        let y = 120 + Math.floor(i / 3) * 140 + (i * 11 % 30);
        particles.push(new Particle(x, y, 'baso4', 22));
      }
    }

    // 3. Add Fine CaCO3 Particles
    if (c > 0) {
      const caco3Count = Math.round(c * 7);
      for (let i = 0; i < caco3Count; i++) {
        let x = 60 + (i % 8) * (width / 8.5) + (i * 13 % 20);
        let y = 80 + Math.floor(i / 8) * 90 + (i * 29 % 30);
        particles.push(new Particle(x, y, 'caco3', 7.5));
      }
    }

    // 4. Add TiO2 Particles (Primary Light Scatterers)
    const seedPoints = [
      {x: 0.2, y: 0.25}, {x: 0.38, y: 0.2}, {x: 0.6, y: 0.22}, {x: 0.8, y: 0.26},
      {x: 0.18, y: 0.5}, {x: 0.35, y: 0.48}, {x: 0.58, y: 0.52}, {x: 0.78, y: 0.55},
      {x: 0.22, y: 0.75}, {x: 0.42, y: 0.78}, {x: 0.62, y: 0.74}, {x: 0.82, y: 0.8},
      {x: 0.3, y: 0.35}, {x: 0.5, y: 0.36}, {x: 0.7, y: 0.38}, {x: 0.48, y: 0.65}
    ];

    const tio2Count = Math.round(tio2 / 3.8);
    for (let i = 0; i < tio2Count; i++) {
      let pt = seedPoints[i % seedPoints.length];
      let baseCoordX = pt.x * width;
      let baseCoordY = pt.y * height;

      // Displacement based on extender spacing
      let offsetX = (baseCoordX - width / 2) * (spacingFactor - 1);
      let offsetY = (baseCoordY - height / 2) * (spacingFactor - 1);

      particles.push(new Particle(baseCoordX + offsetX, baseCoordY + offsetY, 'tio2', 15));
    }

    // Initialize Incident Light Rays
    lightRays = [];
    for (let i = 0; i < numRays; i++) {
      lightRays.push(new PhotonRay(Math.random() * width, Math.random() * -100, Math.PI / 2 + (Math.random() - 0.5) * 0.3));
    }
  }

  function animate() {
    ctx.clearRect(0, 0, width, height);

    const showFields = showFieldsCheckbox.checked;
    const showRays = showRaysCheckbox.checked;

    // Render Particles
    for (let p of particles) {
      p.draw(ctx, showFields);
    }

    // Update and Render Light Rays
    if (showRays) {
      for (let ray of lightRays) {
        ray.update(particles);
        ray.draw(ctx);
      }
    }

    animId = requestAnimationFrame(animate);
  }

  // Event Listeners
  caco3Input.addEventListener('input', initSimulation);
  kaolinInput.addEventListener('input', initSimulation);
  baso4Input.addEventListener('input', initSimulation);
  raysInput.addEventListener('input', initSimulation);
  window.addEventListener('resize', resizeCanvas);

  // Initialize
  resizeCanvas();
  animate();
</script>

</body>
</html>
